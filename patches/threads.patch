+/// llama.cpp defaults to 4 threads whatever the machine has. Use all of them, unless
+/// LTENGINE_THREADS says otherwise.
+fn pick_n_threads() -> i32 {
+    std::env::var("LTENGINE_THREADS").ok()
+        .and_then(|v| v.trim().parse::<i32>().ok())
+        .filter(|n| *n > 0)
+        .unwrap_or_else(|| std::thread::available_parallelism().map(|n| n.get() as i32).unwrap_or(4))
+}
